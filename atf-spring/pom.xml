<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.autotestforge</groupId>
        <artifactId>autotestforge</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>atf-spring</artifactId>
    <name>AutoTestForge :: Spring Boot support</name>
    <description>Spring Boot auto-configuration wiring every adapter into the core use cases (shared by CLI and web)</description>

    <dependencies>
        <dependency>
            <groupId>com.autotestforge</groupId>
            <artifactId>atf-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autotestforge</groupId>
            <artifactId>atf-scanner</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autotestforge</groupId>
            <artifactId>atf-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autotestforge</groupId>
            <artifactId>atf-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autotestforge</groupId>
            <artifactId>atf-writer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autotestforge</groupId>
            <artifactId>atf-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
