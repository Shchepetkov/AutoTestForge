# Docker Compose reads this file after you copy it to .env.
# launch-web.ps1 / launch-web.sh do not load .env; use their arguments or environment variables.
# Local access only by default. Set a long random token before publishing outside localhost.
# This protects AutoTestForge itself; it is separate from any LLM API key.
ATF_API_TOKEN=
ATF_BIND_ADDRESS=127.0.0.1
ATF_HTTP_PORT=8080

# Existing Ollama service. In Docker Compose the host gateway reaches host port 11434.
ATF_OLLAMA_BASE_URL=http://host.docker.internal:11434
ATF_OLLAMA_MODEL=qwen2.5-coder:7b
ATF_OLLAMA_TIMEOUT=10m

# Generic OpenAI-compatible endpoint (Qwen/vLLM, LM Studio, LocalAI, etc.).
# Alternatively, enter a connection directly in the website; no .env edit is needed.
ATF_COMPATIBLE_ENABLED=false
ATF_COMPATIBLE_BASE_URL=http://host.docker.internal:8000/v1
ATF_COMPATIBLE_API_KEY=
ATF_COMPATIBLE_MODEL=qwen2.5-coder
ATF_COMPATIBLE_TIMEOUT=5m

# Optional official OpenAI provider.
OPENAI_API_KEY=
